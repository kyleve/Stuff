#!/bin/bash
set -euo pipefail

# codex-watchdog — keep the Codex macOS app running.
#
# This intentionally checks the app's main executable rather than one of its
# helper processes: helpers can briefly outlive the app after a crash. Launches
# use `open -g` so restarting Codex does not steal focus from the active app.

APP_NAME="Codex"
PROCESS_NAME="Codex"
INTERVAL=10

usage() {
    cat <<'USAGE'
Usage: ./codex-watchdog [options]

Polls for the Codex macOS app and launches it whenever it is not running. The
watchdog continues until interrupted with Ctrl-C.

Options:
  --interval SECONDS  Poll interval (default: 10)
  --app NAME          Application name passed to `open -a` (default: Codex)
  --process NAME      Main executable name checked with pgrep (default: Codex)
  -h, --help          Show this help

Examples:
  ./codex-watchdog
  ./codex-watchdog --interval 30
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --interval)
            shift
            INTERVAL="${1:?--interval requires a value}"
            ;;
        --app)
            shift
            APP_NAME="${1:?--app requires a value}"
            ;;
        --process)
            shift
            PROCESS_NAME="${1:?--process requires a value}"
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown option '$1' (see ./codex-watchdog --help)" >&2
            exit 1
            ;;
    esac
    shift
done

case "$INTERVAL" in
    ''|*[!0-9]*)
        echo "error: --interval must be a positive whole number" >&2
        exit 1
        ;;
esac
if [ "$INTERVAL" -eq 0 ]; then
    echo "error: --interval must be greater than zero" >&2
    exit 1
fi

timestamp() { date '+%Y-%m-%d %H:%M:%S'; }

echo "[$(timestamp)] Watching $APP_NAME every $INTERVAL seconds (Ctrl-C to stop)"

while true; do
    if ! pgrep -x "$PROCESS_NAME" >/dev/null 2>&1; then
        echo "[$(timestamp)] $APP_NAME is not running; launching it"
        if ! open -g -a "$APP_NAME"; then
            echo "[$(timestamp)] warning: could not launch $APP_NAME; retrying in $INTERVAL seconds" >&2
        fi
    fi
    sleep "$INTERVAL"
done
