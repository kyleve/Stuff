#!/bin/bash
set -euo pipefail

# icons — add or remove a selectable Where app icon, reproducibly.
#
# Edits only data + asset folders (never Swift):
#   - the app's AppIcon.xcassets
#   - WhereUI's AppIconPreviews.xcassets
#   - AppIcons.json
#
# Ruby owns validation, staging, commit, and rollback. This shell owns only the
# stable public CLI and the pinned-tool bootstrap.

cd "$(dirname "$0")"

APP_CATALOG="Where/Where/Resources/AppIcon.xcassets"
PREVIEW_CATALOG="Where/WhereUI/Sources/Resources/AppIconPreviews.xcassets"
MANIFEST="Where/WhereUI/Sources/Resources/AppIcons.json"

usage() {
    cat <<'USAGE'
Usage:
  ./icons --add <image.png> [--name <Name>] [--id <id>] [--dark <png>] [--tinted <png>] [--dry-run]
  ./icons --remove <name|id> [--dry-run]
  ./icons --list
  ./icons --help

Adds or removes a selectable app icon, keeping the app asset catalog, the
WhereUI preview catalog, and AppIcons.json in sync. Mutations are staged and
validated completely before any destination is replaced; a failed commit is
rolled back.

--add options:
  <image.png>     1024x1024 PNG for the default (light) appearance. Required.
  --name <Name>   Display name shown in the picker (default: derived from the
                  image filename). The asset set is named "AppIcon<Name>".
  --id <id>       Stable manifest id (default: lowercased name).
  --dark <png>    1024x1024 PNG for the dark appearance.
  --tinted <png>  1024x1024 PNG for the tinted (monochrome) appearance.
  --dry-run       Validate and report the mutation without changing files.

The primary "Classic" icon (AppIcon / id "classic") is reserved: it can't be
added or removed.

Examples:
  ./icons --add art/ocean.png --name Ocean --dark art/ocean-dark.png
  ./icons --add art/ocean.png --name Ocean --dry-run
  ./icons --remove ocean
  ./icons --list

After any change, run `./ide --no-open` to regenerate the project so the new
assets are compiled in.
USAGE
}

MODE=""
LIGHT=""
NAME=""
ID=""
DARK=""
TINTED=""
TARGET=""
DRY_RUN=false

[ $# -eq 0 ] && {
    usage
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        --add)
            MODE="add"
            shift
            LIGHT="${1:?--add requires an image path}"
            ;;
        --remove)
            MODE="remove"
            shift
            TARGET="${1:?--remove requires a name or id}"
            ;;
        --list) MODE="list" ;;
        --name) shift; NAME="${1:?--name requires a value}" ;;
        --id) shift; ID="${1:?--id requires a value}" ;;
        --dark) shift; DARK="${1:?--dark requires a value}" ;;
        --tinted) shift; TINTED="${1:?--tinted requires a value}" ;;
        --dry-run) DRY_RUN=true ;;
        -h | --help) usage; exit 0 ;;
        *) echo "error: unknown option '$1' (see ./icons --help)" >&2; exit 1 ;;
    esac
    shift
done

if [ -z "$MODE" ]; then
    echo "error: choose --add, --remove, or --list (see ./icons --help)" >&2
    exit 1
fi
if [ "$DRY_RUN" = true ] && [ "$MODE" = list ]; then
    echo "error: --dry-run only applies to --add or --remove (see ./icons --help)" >&2
    exit 1
fi

ROOT="$PWD" MODE="$MODE" DRY_RUN="$DRY_RUN" \
    APP_CATALOG="$APP_CATALOG" PREVIEW_CATALOG="$PREVIEW_CATALOG" MANIFEST="$MANIFEST" \
    LIGHT="$LIGHT" NAME="$NAME" ID="$ID" DARK="$DARK" TINTED="$TINTED" TARGET="$TARGET" \
    mise exec -- ruby Tools/icon_catalog.rb
