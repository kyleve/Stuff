#!/bin/bash
set -euo pipefail

# icons — add or remove a selectable Where app icon, reproducibly.
#
# Edits only data + asset folders (never Swift):
#   - the app's AppIcon.xcassets        (the alternate appiconset iOS swaps to)
#   - WhereUI's AppIconPreviews.xcassets (the imageset the picker renders, since
#                                         SwiftUI Image() can't load appiconsets)
#   - AppIcons.json                      (the manifest the picker reads)
#
# The build picks up new appiconsets automatically (the Where target sets
# ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS), so there's no build-setting
# or names list to maintain. After any change, run `./ide --no-open` to
# regenerate; compiling the catalogs and building the app is macOS-only.

cd "$(dirname "$0")"

APP_CATALOG="Where/Where/Resources/AppIcon.xcassets"
PREVIEW_CATALOG="Where/WhereUI/Sources/Resources/AppIconPreviews.xcassets"
MANIFEST="Where/WhereUI/Sources/Resources/AppIcons.json"

usage() {
    cat <<'USAGE'
Usage:
  ./icons --add <image.png> [--name <Name>] [--id <id>] [--dark <png>] [--tinted <png>]
  ./icons --replace-primary <image.png> [--dark <png>] [--tinted <png>]
  ./icons --remove <name|id>
  ./icons --list
  ./icons --help

Adds or removes a selectable app icon, keeping the app asset catalog, the
WhereUI preview catalog, and AppIcons.json in sync.

--add options:
  <image.png>     1024x1024 PNG for the default (light) appearance. Required.
  --name <Name>   Display name shown in the picker (default: derived from the
                  image filename). The asset set is named "AppIcon<Name>".
  --id <id>       Stable manifest id (default: lowercased name).
  --dark <png>    1024x1024 PNG for the dark appearance.
  --tinted <png>  1024x1024 PNG for the tinted (monochrome) appearance.

--replace-primary replaces the artwork for the reserved Classic identity while
keeping its stable manifest id and primary-icon status.

The primary "Classic" icon (AppIcon / id "classic") is reserved: it can't be
added or removed.

Examples:
  ./icons --add art/ocean.png --name Ocean --dark art/ocean-dark.png
  ./icons --replace-primary art/signature.png --dark art/signature-dark.png --tinted art/signature-tinted.png
  ./icons --remove ocean
  ./icons --list

After any change, run `./ide --no-open` to regenerate the project so the new
assets are compiled in.
USAGE
}

MODE=""
LIGHT=""
NAME=""
ID=""
DARK=""
TINTED=""
TARGET=""

[ $# -eq 0 ] && {
    usage
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        --add)
            MODE="add"
            shift
            LIGHT="${1:?--add requires an image path}"
            ;;
        --replace-primary)
            MODE="replace-primary"
            shift
            LIGHT="${1:?--replace-primary requires an image path}"
            ;;
        --remove)
            MODE="remove"
            shift
            TARGET="${1:?--remove requires a name or id}"
            ;;
        --list) MODE="list" ;;
        --name)
            shift
            NAME="${1:?--name requires a value}"
            ;;
        --id)
            shift
            ID="${1:?--id requires a value}"
            ;;
        --dark)
            shift
            DARK="${1:?--dark requires a value}"
            ;;
        --tinted)
            shift
            TINTED="${1:?--tinted requires a value}"
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown option '$1' (see ./icons --help)" >&2
            exit 1
            ;;
    esac
    shift
done

if [ -z "$MODE" ]; then
    echo "error: choose --add, --remove, or --list (see ./icons --help)" >&2
    exit 1
fi

MODE="$MODE" \
    APP_CATALOG="$APP_CATALOG" PREVIEW_CATALOG="$PREVIEW_CATALOG" MANIFEST="$MANIFEST" \
    LIGHT="$LIGHT" NAME="$NAME" ID="$ID" DARK="$DARK" TINTED="$TINTED" TARGET="$TARGET" \
    python3 - <<'PY'
import json
import os
import re
import shutil
import struct
import sys

MODE = os.environ["MODE"]
APP_CATALOG = os.environ["APP_CATALOG"]
PREVIEW_CATALOG = os.environ["PREVIEW_CATALOG"]
MANIFEST = os.environ["MANIFEST"]

PRIMARY_SET = "AppIcon"
PRIMARY_ID = "classic"


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def require_repo_layout():
    missing = [
        path
        for path in (MANIFEST, APP_CATALOG, PREVIEW_CATALOG)
        if not os.path.exists(path)
    ]
    if missing:
        die("couldn't find " + ", ".join(missing) + " — run ./icons from the repo root")


def load_manifest():
    require_repo_layout()
    try:
        with open(MANIFEST) as f:
            return json.load(f)
    except json.JSONDecodeError as error:
        die(f"{MANIFEST} is not valid JSON: {error}")


def save_manifest(data):
    out = json.dumps(data, indent=2, ensure_ascii=False, separators=(",", " : "))
    with open(MANIFEST, "w") as f:
        f.write(out + "\n")


def write_contents(path, images):
    obj = {"images": images, "info": {"author": "xcode", "version": 1}}
    out = json.dumps(obj, indent=2, ensure_ascii=False, separators=(",", " : "))
    with open(path, "w") as f:
        f.write(out + "\n")


def require_1024(path):
    if not os.path.isfile(path):
        die(f"no such file: {path}")
    with open(path, "rb") as f:
        head = f.read(24)
    if head[:8] != b"\x89PNG\r\n\x1a\n":
        die(f"not a PNG: {path}")
    width, height = struct.unpack(">II", head[16:24])
    if (width, height) != (1024, 1024):
        die(f"{path} is {width}x{height}; app icons must be 1024x1024")


def pascal_case(text):
    parts = re.split(r"[^A-Za-z0-9]+", text)
    return "".join(p[:1].upper() + p[1:] for p in parts if p)


def slug(text):
    return re.sub(r"[^a-z0-9]+", "", text.lower())


def do_list():
    icons = load_manifest().get("icons", [])
    if not icons:
        print("(no icons in the manifest)")
        return
    id_width = max(len(i["id"]) for i in icons)
    name_width = max(len(i["displayName"]) for i in icons)
    for icon in icons:
        alt = icon.get("alternateIconName") or "(primary)"
        print(f"  {icon['id']:<{id_width}}  {icon['displayName']:<{name_width}}  {alt}")


def do_add():
    light = os.environ["LIGHT"]
    dark = os.environ.get("DARK") or ""
    tinted = os.environ.get("TINTED") or ""
    name = os.environ.get("NAME") or pascal_case(os.path.splitext(os.path.basename(light))[0])
    if not name:
        die("couldn't derive a name; pass --name")
    icon_id = os.environ.get("ID") or slug(name)
    if not icon_id:
        die("couldn't derive an id; pass --id")
    # PascalCase so a lowercase --name still yields "AppIcon<Name>".
    set_name = PRIMARY_SET + pascal_case(name)

    if set_name == PRIMARY_SET or icon_id == PRIMARY_ID:
        die(f'"{PRIMARY_ID}" / "{PRIMARY_SET}" is the reserved primary icon')

    require_1024(light)
    if dark:
        require_1024(dark)
    if tinted:
        require_1024(tinted)

    data = load_manifest()
    icons = data.setdefault("icons", [])
    for icon in icons:
        if icon["id"] == icon_id:
            die(f'an icon with id "{icon_id}" already exists (use --id to pick another)')
        if icon.get("alternateIconName") == set_name:
            die(f'an icon named "{set_name}" already exists')

    appiconset = os.path.join(APP_CATALOG, set_name + ".appiconset")
    imageset = os.path.join(PREVIEW_CATALOG, set_name + ".imageset")
    for path in (appiconset, imageset):
        if os.path.exists(path):
            die(f"{path} already exists")

    # App appiconset (what iOS swaps to): a single 1024 slot per appearance.
    os.makedirs(appiconset)
    app_images = [
        {"filename": set_name + ".png", "idiom": "universal", "platform": "ios", "size": "1024x1024"},
    ]
    shutil.copyfile(light, os.path.join(appiconset, set_name + ".png"))
    if dark:
        app_images.append({
            "appearances": [{"appearance": "luminosity", "value": "dark"}],
            "filename": set_name + "-Dark.png", "idiom": "universal",
            "platform": "ios", "size": "1024x1024",
        })
        shutil.copyfile(dark, os.path.join(appiconset, set_name + "-Dark.png"))
    if tinted:
        app_images.append({
            "appearances": [{"appearance": "luminosity", "value": "tinted"}],
            "filename": set_name + "-Tinted.png", "idiom": "universal",
            "platform": "ios", "size": "1024x1024",
        })
        shutil.copyfile(tinted, os.path.join(appiconset, set_name + "-Tinted.png"))
    write_contents(os.path.join(appiconset, "Contents.json"), app_images)

    # Preview imageset (what the picker renders): light + optional dark.
    os.makedirs(imageset)
    preview_images = [{"filename": set_name + ".png", "idiom": "universal"}]
    shutil.copyfile(light, os.path.join(imageset, set_name + ".png"))
    if dark:
        preview_images.append({
            "appearances": [{"appearance": "luminosity", "value": "dark"}],
            "filename": set_name + "-Dark.png", "idiom": "universal",
        })
        shutil.copyfile(dark, os.path.join(imageset, set_name + "-Dark.png"))
    write_contents(os.path.join(imageset, "Contents.json"), preview_images)

    icons.append({
        "id": icon_id,
        "displayName": name,
        "alternateIconName": set_name,
        "previewImageName": set_name,
    })
    save_manifest(data)
    print(f'Added "{name}" (id: {icon_id}, asset: {set_name}).')
    print("Run `./ide --no-open` to regenerate so the new icon is compiled in.")


def do_replace_primary():
    light = os.environ["LIGHT"]
    dark = os.environ.get("DARK") or ""
    tinted = os.environ.get("TINTED") or ""
    require_1024(light)
    if dark:
        require_1024(dark)
    if tinted:
        require_1024(tinted)

    # Read before rebuilding the catalog folders so replacing in-place is safe.
    with open(light, "rb") as source:
        light_data = source.read()
    if dark:
        with open(dark, "rb") as source:
            dark_data = source.read()
    else:
        dark_data = None
    if tinted:
        with open(tinted, "rb") as source:
            tinted_data = source.read()
    else:
        tinted_data = None

    data = load_manifest()
    primary = next(
        (
            icon
            for icon in data.get("icons", [])
            if icon.get("id") == PRIMARY_ID and icon.get("alternateIconName") is None
        ),
        None,
    )
    if primary is None:
        die(f'the manifest has no reserved primary icon with id "{PRIMARY_ID}"')

    appiconset = os.path.join(APP_CATALOG, PRIMARY_SET + ".appiconset")
    preview_set_name = primary["previewImageName"]
    imageset = os.path.join(PREVIEW_CATALOG, preview_set_name + ".imageset")
    for path in (appiconset, imageset):
        if os.path.isdir(path):
            shutil.rmtree(path)
        os.makedirs(path)

    app_images = [
        {"filename": PRIMARY_SET + ".png", "idiom": "universal", "platform": "ios", "size": "1024x1024"},
    ]
    with open(os.path.join(appiconset, PRIMARY_SET + ".png"), "wb") as destination:
        destination.write(light_data)
    if dark:
        app_images.append({
            "appearances": [{"appearance": "luminosity", "value": "dark"}],
            "filename": PRIMARY_SET + "-Dark.png", "idiom": "universal",
            "platform": "ios", "size": "1024x1024",
        })
        with open(os.path.join(appiconset, PRIMARY_SET + "-Dark.png"), "wb") as destination:
            destination.write(dark_data)
    if tinted:
        app_images.append({
            "appearances": [{"appearance": "luminosity", "value": "tinted"}],
            "filename": PRIMARY_SET + "-Tinted.png", "idiom": "universal",
            "platform": "ios", "size": "1024x1024",
        })
        with open(os.path.join(appiconset, PRIMARY_SET + "-Tinted.png"), "wb") as destination:
            destination.write(tinted_data)
    write_contents(os.path.join(appiconset, "Contents.json"), app_images)

    preview_images = [{"filename": preview_set_name + ".png", "idiom": "universal"}]
    with open(os.path.join(imageset, preview_set_name + ".png"), "wb") as destination:
        destination.write(light_data)
    if dark:
        preview_images.append({
            "appearances": [{"appearance": "luminosity", "value": "dark"}],
            "filename": preview_set_name + "-Dark.png", "idiom": "universal",
        })
        with open(os.path.join(imageset, preview_set_name + "-Dark.png"), "wb") as destination:
            destination.write(dark_data)
    write_contents(os.path.join(imageset, "Contents.json"), preview_images)

    print('Replaced primary "Classic" artwork without changing its stable id.')
    print("Run `./ide --no-open` to regenerate so the new artwork is compiled in.")


def do_remove():
    target = os.environ["TARGET"]
    if target.lower() in (PRIMARY_ID, PRIMARY_SET.lower()):
        die('the primary "Classic" icon can\'t be removed')

    data = load_manifest()
    icons = data.get("icons", [])
    match = next(
        (
            icon
            for icon in icons
            if target.lower()
            in {
                icon["id"].lower(),
                icon["displayName"].lower(),
                (icon.get("alternateIconName") or "").lower(),
            }
        ),
        None,
    )
    if match is None:
        die(f'no icon matching "{target}" (try ./icons --list)')
    if match.get("alternateIconName") is None:
        die('the primary "Classic" icon can\'t be removed')

    set_name = match["alternateIconName"]
    for path in (
        os.path.join(APP_CATALOG, set_name + ".appiconset"),
        os.path.join(PREVIEW_CATALOG, set_name + ".imageset"),
    ):
        if os.path.isdir(path):
            shutil.rmtree(path)

    data["icons"] = [icon for icon in icons if icon is not match]
    save_manifest(data)
    print(f'Removed "{match["displayName"]}" (id: {match["id"]}).')
    print("If it was the active icon, the app falls back to Classic on next launch.")
    print("Run `./ide --no-open` to regenerate.")


if MODE == "list":
    do_list()
elif MODE == "add":
    do_add()
elif MODE == "replace-primary":
    do_replace_primary()
elif MODE == "remove":
    do_remove()
else:
    die(f"unknown mode: {MODE}")
PY
