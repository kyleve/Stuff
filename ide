#!/bin/bash
set -euo pipefail

# CI runs formatting via the workflow's `format` job;
# this only configures the local pre-commit hook.
git config core.hooksPath .githooks

# Gitignored, machine-local mise config that overrides/extends .mise.toml.
LOCAL_MISE=".mise.local.toml"

INSTALL=false
OPEN=true
TEAM_ID=""

while [ $# -gt 0 ]; do
    case "$1" in
        -i|--install)
            INSTALL=true
            ;;
        --no-open)
            OPEN=false
            ;;
        --team-id)
            shift
            TEAM_ID="${1:-}"
            if [ -z "$TEAM_ID" ]; then
                echo "error: --team-id requires a value (e.g. ./ide --team-id ABCDE12345)" >&2
                exit 1
            fi
            ;;
        --team-id=*)
            TEAM_ID="${1#--team-id=}"
            if [ -z "$TEAM_ID" ]; then
                echo "error: --team-id requires a value (e.g. ./ide --team-id ABCDE12345)" >&2
                exit 1
            fi
            ;;
    esac
    shift
done

# Persist the Apple Developer Team ID into the gitignored .mise.local.toml so
# Project.swift can read TUIST_DEVELOPMENT_TEAM and stamp DEVELOPMENT_TEAM into
# the generated project — no re-picking your team in Xcode after every
# regeneration, and nothing machine-specific gets committed. Let mise own the
# TOML: `mise set` creates the file and the [env] table as needed.
if [ -n "$TEAM_ID" ]; then
    echo "==> mise set TUIST_DEVELOPMENT_TEAM=$TEAM_ID (in $LOCAL_MISE)"
    mise set --file "$LOCAL_MISE" "TUIST_DEVELOPMENT_TEAM=$TEAM_ID"
fi

if [ "$INSTALL" = true ]; then
    echo "==> tuist install"
    mise exec -- tuist install
fi

echo "==> sync-agents --install"
./sync-agents --install

if [ "$OPEN" = true ]; then
    echo "==> tuist generate"
    mise exec -- tuist generate
else
    echo "==> tuist generate --no-open"
    mise exec -- tuist generate --no-open
fi
