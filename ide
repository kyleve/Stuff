#!/bin/bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ./ide [--bootstrap] [--install] [--no-open] [--team-id ID]

Set up repository tooling and generate the Xcode project.

Options:
  --bootstrap, --setup  Install Homebrew, mise, and development tools.
  -i, --install        Resolve project and install-site dependencies first.
  --no-open            Generate without opening Xcode.
  --team-id ID         Persist the Apple Developer Team ID for this checkout.
  -h, --help           Show this help without performing setup.
EOF
}

# Parse the public interface before consulting Git, LFS, Xcode, or mise. Help
# and usage errors must be safe in a fresh checkout and from another cwd.
BOOTSTRAP=false
INSTALL=false
OPEN=true
TEAM_ID=""

while [ $# -gt 0 ]; do
    case "$1" in
        --bootstrap|--setup)
            BOOTSTRAP=true
            ;;
        -i|--install)
            INSTALL=true
            ;;
        --no-open)
            OPEN=false
            ;;
        --team-id)
            shift
            TEAM_ID="${1:-}"
            if [ -z "$TEAM_ID" ]; then
                echo "error: --team-id requires a value (e.g. ./ide --team-id ABCDE12345)" >&2
                exit 1
            fi
            ;;
        --team-id=*)
            TEAM_ID="${1#--team-id=}"
            if [ -z "$TEAM_ID" ]; then
                echo "error: --team-id requires a value (e.g. ./ide --team-id ABCDE12345)" >&2
                exit 1
            fi
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown option '$1'" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

script_root=$(CDPATH='' cd "$(dirname "$0")" && pwd)
cd "$script_root"

# Gitignored, machine-local mise config that overrides/extends .mise.toml.
LOCAL_MISE=".mise.local.toml"

# Codex worktree setup can start without Homebrew's shell profile on PATH.
find_brew() {
    command -v brew 2>/dev/null && return
    local candidate
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$candidate" ] && { echo "$candidate"; return; }
    done
    return 0
}

install_homebrew_tools() {
    local brew_path installer shell_environment formula executable
    brew_path="$(find_brew)"
    if [ -z "$brew_path" ]; then
        echo "==> installing Homebrew"
        installer="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        /bin/bash -c "$installer"
        brew_path="$(find_brew)"
    fi
    if [ -z "$brew_path" ]; then
        echo "error: Homebrew installation did not provide brew. Install it from https://brew.sh and rerun bootstrap." >&2
        exit 1
    fi

    shell_environment="$("$brew_path" shellenv bash)"
    eval "$shell_environment"
    for formula in git-lfs gh circleci cloc schpet/tap/linear; do
        executable="${formula##*/}"
        if ! command -v "$executable" >/dev/null 2>&1; then
            echo "==> brew install $formula"
            "$brew_path" install "$formula"
            if ! command -v "$executable" >/dev/null 2>&1; then
                echo "error: Homebrew did not put $executable on PATH." >&2
                exit 1
            fi
        fi
    done
}

# Resolve the mise binary: prefer one already on PATH, otherwise the common
# install locations (the official installer's $HOME/.local/bin, Homebrew). This
# lets bootstrap work before `mise activate` is in the user's shell. Prints
# nothing when mise is unavailable, so callers treat an empty result as
# "not found".
find_mise() {
    command -v mise 2>/dev/null && return
    for candidate in "$HOME/.local/bin/mise" /opt/homebrew/bin/mise /usr/local/bin/mise; do
        [ -x "$candidate" ] && { echo "$candidate"; return; }
    done
    return 0
}

# Idempotently add `mise activate` to the user's shell rc so mise and the pinned
# tools land on PATH in new interactive shells. This is a convenience only —
# ./ide and the git hooks resolve mise directly (see find_mise), so nothing
# breaks without it. Only touches a known rc (zsh/bash), never duplicates the
# line, and prints a manual note for other shells.
ensure_mise_activation() {
    local shell_name rc activate_line
    shell_name="$(basename "${SHELL:-}")"
    case "$shell_name" in
        zsh)
            rc="$HOME/.zshrc"
            # shellcheck disable=SC2016 # Write this expression literally to the rc file.
            activate_line='eval "$(mise activate zsh)"'
            ;;
        bash)
            rc="$HOME/.bashrc"
            # shellcheck disable=SC2016 # Write this expression literally to the rc file.
            activate_line='eval "$(mise activate bash)"'
            ;;
        *)
            echo "note: add mise activation to your shell's rc so mise is on PATH in new shells (https://mise.jdx.dev/getting-started.html)"
            return
            ;;
    esac

    if [ -f "$rc" ] && grep -q "mise activate" "$rc"; then
        return
    fi

    printf '\n# Added by ./ide --bootstrap: put mise (and the pinned tools) on PATH\n%s\n' "$activate_line" >>"$rc"
    echo "==> added mise activation to $rc (restart your shell or run: source $rc)"
}

if [ "$BOOTSTRAP" = true ]; then
    # Xcode must be a full Xcode.app (not just the Command Line Tools) and
    # runnable — Tuist can't operate against the CLT alone. We check-and-instruct
    # rather than install: Xcode is a large, interactive App Store download.
    xcode_path="$(xcode-select -p 2>/dev/null || true)"
    if [ -z "$xcode_path" ] || [[ "$xcode_path" == *CommandLineTools* ]] || ! xcodebuild -version >/dev/null 2>&1; then
        cat >&2 <<'EOF'
error: a full Xcode installation is required (Tuist can't run against the Command Line Tools alone).

Fix it, then re-run ./ide --bootstrap:
  1. Install Xcode from the App Store (or https://developer.apple.com/download).
  2. sudo xcode-select -s /Applications/Xcode.app
  3. sudo xcodebuild -runFirstLaunch
  4. sudo xcodebuild -license accept
EOF
        exit 1
    fi

    install_homebrew_tools
fi

# Check for Git LFS before enabling hooks that require it for Git operations.
if ! command -v git-lfs >/dev/null 2>&1; then
    echo "error: git-lfs is required. Run ./ide --bootstrap to install it." >&2
    exit 1
fi

git lfs install --local --skip-repo >/dev/null
git config core.hooksPath .githooks

if [ "$BOOTSTRAP" = true ]; then
    # Use mise's official installer to match the existing mise setup.
    if [ -z "$(find_mise)" ]; then
        echo "==> installing mise"
        curl -fsSL https://mise.run | sh
        ensure_mise_activation
    fi

    MISE="$(find_mise)"
    if [ -z "$MISE" ]; then
        echo "error: mise installation failed; install it manually from https://mise.jdx.dev" >&2
        exit 1
    fi

    # Every clone and worktree has a distinct config path, and mise refuses to
    # read an untrusted .mise.toml. Running this explicit bootstrap is the trust
    # boundary, so make fresh checkouts usable without a separate manual step.
    echo "==> mise trust"
    "$MISE" trust

    # Install the pinned tools from .mise.toml.
    echo "==> mise install"
    "$MISE" install

    # Codex may create a managed worktree with LFS smudging disabled, leaving
    # snapshot references as pointer text even though git-lfs is installed.
    # Bootstrap is already the networked, one-shot setup boundary, and all
    # worktrees share the repository's LFS object cache, so hydrate the current
    # checkout here deterministically. A failed download must fail setup: an
    # apparently ready checkout with pointer-backed references cannot run or
    # re-record snapshots honestly.
    echo "==> git lfs pull"
    git lfs pull
fi

MISE="$(find_mise)"
if [ -z "$MISE" ]; then
    echo "error: mise not found — run ./ide --bootstrap first to set up this machine." >&2
    exit 1
fi

# Persist the Apple Developer Team ID into the gitignored .mise.local.toml so
# Project.swift can read TUIST_DEVELOPMENT_TEAM and stamp DEVELOPMENT_TEAM into
# the generated project — no re-picking your team in Xcode after every
# regeneration, and nothing machine-specific gets committed. Let mise own the
# TOML: `mise set` creates the file and the [env] table as needed.
if [ -n "$TEAM_ID" ]; then
    echo "==> mise set TUIST_DEVELOPMENT_TEAM=$TEAM_ID (in $LOCAL_MISE)"
    "$MISE" set --file "$LOCAL_MISE" "TUIST_DEVELOPMENT_TEAM=$TEAM_ID"
fi

if [ "$INSTALL" = true ]; then
    echo "==> tuist install"
    "$MISE" exec -- tuist install
fi

if [ "$BOOTSTRAP" = true ] || [ "$INSTALL" = true ]; then
    echo "==> install locked Ruby dependencies"
    BUNDLE_PATH=vendor/bundle BUNDLE_FROZEN=true "$MISE" exec -- bundle install
    echo "==> install site dependencies"
    "$MISE" exec -- npm ci
fi

echo "==> sync-agents --install"
"$MISE" exec -- ./sync-agents --install

if [ "$OPEN" = true ]; then
    echo "==> tuist generate"
    "$MISE" exec -- tuist generate
else
    echo "==> tuist generate --no-open"
    "$MISE" exec -- tuist generate --no-open
fi
