#!/bin/bash
# Run from this checkout with its pinned simulator. Keep these experiments out of normal CI.
set -euo pipefail

probe_dir=$(cd "$(dirname "$0")/Probes" && pwd)
repo=$(git -C "$probe_dir" rev-parse --show-toplevel)
output=$(mktemp -d /private/tmp/stuff-requested-frames.XXXXXX)
echo "Experiment output: $output"
cd "$repo"

banner="$repo/Where/WhereUI/SnapshotTests/BannerFrameProbeTests.swift"
locations="$repo/Where/WhereUI/Tests/LocationsFrameProbeTests.swift"
reuse="$repo/Where/WhereUI/SnapshotTests/FrameReuseProbeTests.swift"

# Register each destination before linking, so an interrupt cannot strand a probe.
# Private source inodes let cleanup distinguish this run from another invocation.
staging="$repo/.requested-frame-probes"
if ! mkdir "$staging"; then
    echo "The checkout already has a requested-frame run or an interrupted staging directory: $staging" >&2
    exit 1
fi
installed=()
restore_project=false
restore_products() {
    ./ide --no-open > "$output/restore-project.log" 2>&1 || return 1
    {
        TEST_WORKDIR="$output/restored" ./test --no-generate --skip-architecture --skip-host-tests \
            --record never --only WhereUITests/FlightReviewPresentationTests \
            --only WhereUISnapshotTests/FlightStatusBannerSnapshotTests
    } > "$output/restore-products.log" 2>&1
}
cleanup() {
    local status=$? name source
    trap - EXIT INT TERM
    for name in ${installed[@]+"${installed[@]}"}; do
        source="$staging/${name##*/}"
        if [[ "$source" -ef "$name" ]]; then
            unlink "$name" || status=1
        fi
    done
    for source in "$staging"/*.swift; do
        if [[ -f "$source" ]]; then unlink "$source" || status=1; fi
    done
    if [[ "$restore_project" == true ]]; then
        # Restore normal project membership and reusable test products.
        if ! restore_products; then
            echo "Could not restore the normal test products. See $output/restore-*.log" >&2
            if [[ "$status" == 0 ]]; then status=1; fi
        fi
    fi
    rmdir "$staging" || status=1
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
for name in "$banner" "$locations" "$reuse"; do
    source="$staging/${name##*/}"
    cp "$probe_dir/${name##*/}" "$source"
    installed+=("$name")
    ln "$source" "$name"
done

restore_project=true
# Both schemes build StuffTestHost.app at the same path. Complete each scheme's
# two process launches before the other scheme can replace its host executable.
mkdir "$output/first" "$output/repeat"
for scheme in banner locations; do
    for pass in first repeat; do
        flags=()
        if [[ "$pass" == repeat ]]; then
            flags+=(--no-generate --no-build --skip-architecture --skip-host-tests)
        elif [[ "$scheme" == locations ]]; then
            flags+=(--no-generate --skip-architecture --skip-host-tests)
        fi
        if [[ "$scheme" == banner ]]; then
            cases=(--only WhereUISnapshotTests/BannerFrameProbeTests --only WhereUISnapshotTests/FrameReuseProbeTests)
        else
            cases=(--only WhereUITests/LocationsFrameProbeTests)
        fi
        TEST_RUNNER_REQUESTED_FRAME_CACHE="$output/cache" TEST_RUNNER_REQUESTED_FRAME_PASS="$pass" \
            TEST_RUNNER_REQUESTED_FRAME_OUTPUT="$output/$pass" \
            TEST_WORKDIR="$output/$pass/$scheme-test" ./test ${flags[@]+"${flags[@]}"} \
            --record never --timings --review "${cases[@]}"
    done
done

swiftc -O "$probe_dir/../audit-frames.swift" -o "$output/audit-frames"
"$output/audit-frames" "$output" | tee "$output/pixels.txt"
