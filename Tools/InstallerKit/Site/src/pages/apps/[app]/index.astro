---
import { site, mainChannel, type App, type ActiveChannel } from '../../../data';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AppHero from '../../../components/AppHero.astro';
import BuildSummary from '../../../components/BuildSummary.astro';
import BranchRow from '../../../components/BranchRow.astro';
import EmptyState from '../../../components/EmptyState.astro';
import InstallHelp from '../../../components/InstallHelp.astro';
export function getStaticPaths() {
  return site.apps.map(app => ({ params: { app: app.id }, props: { app } }));
}
interface Props { app: App }
const { app } = Astro.props;
const main = mainChannel(app);
const branches = app.channels.filter((channel): channel is ActiveChannel => channel.state === 'active' && channel.name !== 'main')
  .sort((a, b) => Number(b.name.slice(3)) - Number(a.name.slice(3)));
---
<SiteLayout title={app.name + ' builds'}>
  <Breadcrumbs app={app}/>
  <AppHero app={app} channel={main} label="LATEST MAIN BUILD"/>
  {main ? (
    <BuildSummary app={app} channel={main}/>
  ) : (
    <EmptyState title="No main build yet" message="The latest successful main build will appear here."/>
  )}
  <section class="section">
    <div class="section-heading">
      <h2>Pull Request Builds</h2>
      <p>{branches.length} available</p>
    </div>
    {branches.length ? (
      <div class="channel-list">{branches.map(channel => <BranchRow app={app} channel={channel}/>)}</div>
    ) : (
      <EmptyState title="No pull request builds" message="Installable pull requests will appear here."/>
    )}
    <p class="section-note">Switching channels replaces this development app and preserves its data.</p>
  </section>
  <InstallHelp/>
</SiteLayout>
