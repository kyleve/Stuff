    "about.geographicDataDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Made with Natural Earth. Throw uses generalized 1:10m global data and selected 2025 U.S. Census Bureau boundaries and roads. The data is non-authoritative. Natural Earth uses its default de facto boundary view. Census boundaries support statistical work and are not legal land descriptions. TIGER/Line® is a registered trademark of the U.S. Census Bureau. Throw uses the name only to identify its source data."
          }
        }
      }
    },
