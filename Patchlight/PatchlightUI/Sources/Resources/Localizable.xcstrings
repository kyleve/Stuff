    "#%lld %@" : {
      "comment" : "A button that opens a pull request.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "#%1$lld %2$@"
          }
        }
      }
    },
    "%@ / %@" : {
      "comment" : "A label displaying the name of the image analysis provider and the model ID used for the analysis. The argument is the string “OpenAI” or the string “Anthropic”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@/%@" : {
      "comment" : "A badge that displays a GitHub organization and repository name. The first argument is the organization name. The second argument is the repository name.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@/%2$@"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "A label that displays a warning icon and a message. The first argument is the name of the repository. The second argument is an error message.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@:%@" : {
      "comment" : "A label that shows the file path and line number of the issue. The first argument is the file path. The second argument is the line number, or \"–\" if not available.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@:%2$@"
          }
        }
      }
    },
