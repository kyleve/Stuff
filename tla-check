#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

tlc_version="1.7.4"
tlc_sha256="936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88"
tlc_url="https://github.com/tlaplus/tlaplus/releases/download/v${tlc_version}/tla2tools.jar"
pcal_version="1.11"
java_version="temurin-21.0.8+9.0.LTS"

tool_root="$repo_root/.build/tla"
jar_dir="$tool_root/v${tlc_version}"
jar_path="$jar_dir/tla2tools.jar"
runs_dir="$tool_root/runs"

usage() {
    cat <<'EOF'
Usage: ./tla-check [--list] [SPEC ...]

Generate and run TLA+ model checks declared under
*/Specifications/*/manifest.json at the repository root.
With no SPEC names, every discoverable spec is checked.

Options:
  --list    Print discoverable spec folder names and exit
  --help    Show this help

PlusCal manifests are translated only inside the retained run directory;
tracked model sources are never rewritten.

Downloads pinned TLC and Java into .build/tla/ on first use (~350 MB).
Set TLA_JAVA to a Java executable to bypass the pinned mise runtime.
EOF
}

checksum() {
    shasum -a 256 "$1" | awk '{print $1}'
}

ensure_tools() {
    mkdir -p "$jar_dir" "$runs_dir"

    if [[ ! -f "$jar_path" ]]; then
        download_path="$(mktemp "$jar_dir/tla2tools.jar.download.XXXXXX")"
        echo "Downloading TLC ${tlc_version}..."
        if curl --fail --location --retry 3 --output "$download_path" "$tlc_url"; then
            :
        else
            download_status=$?
            rm -f "$download_path"
            return "$download_status"
        fi
        if [[ "$(checksum "$download_path")" != "$tlc_sha256" ]]; then
            rm -f "$download_path"
            echo "TLC download checksum did not match ${tlc_sha256}." >&2
            exit 1
        fi
        mv "$download_path" "$jar_path"
    fi

    if [[ "$(checksum "$jar_path")" != "$tlc_sha256" ]]; then
        echo "Cached TLC checksum did not match ${tlc_sha256}." >&2
        exit 1
    fi

    export MISE_DATA_DIR="$tool_root/mise/data"
    export MISE_CACHE_DIR="$tool_root/mise/cache"
    export MISE_STATE_DIR="$tool_root/mise/state"
    export MISE_CONFIG_DIR="$tool_root/mise/config"
}

discover_specs() {
    python3 "$repo_root/Tools/tla_check.py" discover "$repo_root"
}

resolve_specs() {
    python3 "$repo_root/Tools/tla_check.py" resolve "$repo_root" "$@"
}

list_specs() {
    local rows name spec_dir
    rows="$(discover_specs)" || return $?
    while IFS=$'\t' read -r name spec_dir; do
        printf '%s\n' "$name"
    done <<<"$rows"
}

run_spec() {
    local spec_name="$1"
    local spec_dir="$2"
    local manifest="$spec_dir/manifest.json"
    local run_dir

    run_dir="$(mktemp -d "$runs_dir/${spec_name}.XXXXXX")"

    echo "==> $spec_name"
    python3 "$repo_root/Tools/tla_check.py" \
        "$manifest" "$spec_dir" "$run_dir" "$jar_path" \
        "$tlc_version" "$pcal_version" "$java_version" "$tlc_sha256"
}

main() {
    local list_only=false
    local specs=()
    local resolved_spec_rows
    local selected_names=()
    local selected_directories=()
    local selected_name selected_directory index

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h | --help)
                usage
                exit 0
                ;;
            --list)
                list_only=true
                shift
                ;;
            --)
                shift
                specs+=("$@")
                break
                ;;
            -*)
                echo "error: unknown option '$1'" >&2
                usage >&2
                exit 2
                ;;
            *)
                specs+=("$1")
                shift
                ;;
        esac
    done

    if $list_only; then
        list_specs
        exit 0
    fi

    resolved_spec_rows="$(resolve_specs "${specs[@]}")" || return $?
    while IFS=$'\t' read -r selected_name selected_directory; do
        selected_names+=("$selected_name")
        selected_directories+=("$selected_directory")
    done <<<"$resolved_spec_rows"

    ensure_tools

    local failed=false
    for ((index = 0; index < ${#selected_names[@]}; index++)); do
        if ! run_spec "${selected_names[$index]}" "${selected_directories[$index]}"; then
            failed=true
        fi
    done

    if $failed; then
        exit 1
    fi

    echo "All TLA+ checks passed (${#selected_names[@]} spec(s))."
}

main "$@"
