{
  "name": "foreman-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that spins up git worktree/clone copies of repos and hands them to Foreman to run as cursor-agent workers.",
  "bin": {
    "foreman-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "smoke": "node test/smoke.mjs",
    "test": "node test/smoke.mjs && node test/integration.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
