{
  "sourceLanguage" : "en",
  "strings" : {
    "config.loadFailure" : {
      "comment" : "Surfaced when the saved configuration file existed but couldn't be read; Foreman falls back to defaults.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't read saved settings — using defaults."
          }
        }
      }
    },
    "cursorAgent.notFound" : {
      "comment" : "Error when the cursor-agent executable couldn't be located. The placeholder is a comma-separated list of paths that were checked.",
