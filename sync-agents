#!/usr/bin/env ruby
# frozen_string_literal: true
#
# sync-agents — keep AI agent configuration in sync across tools.
#
# AGENTS.md is shared directly. Claude skill folders link to .agents/skills/.
# Legacy generated instructions and matching skill copies are migrated safely.
#
# Commands:
#   ./sync-agents                        Remove generated CLAUDE.md files
#                                        and link canonical skill folders.
#
#   ./sync-agents --install              Fetch external skills listed in
#                                        .agents/external-skills.json.
#                                        Repairs invalid installations.
#                                        Run automatically by ./ide.
#
#   ./sync-agents --add <url> [name]     Add an external skill from a
#                                        GitHub repo. Clones the repo,
#                                        copies the skill into
#                                        .agents/skills/, and pins the
#                                        commit SHA in the manifest.
#
#   ./sync-agents --update               Re-fetch all external skills
#                                        from their repos at the latest
#                                        commit. Updates the pinned SHA
#                                        in the manifest.
#
#   ./sync-agents --git-add              Sync, then stage any changed
#                                        files with git. Used by the
#                                        pre-commit hook.

require "fileutils"
require "json"
require "tmpdir"
require "open3"
require_relative "Tools/repository"
require_relative "Tools/agent_skill_installer"
require_relative "Tools/agent_guidance"
require_relative "Tools/agent_compatibility"

REPO_ROOT = Repository.root(__FILE__)

class SyncAgents
  def initialize(repository_root: REPO_ROOT)
    @repository_root = File.expand_path(repository_root)
    @skills_directory = File.join(@repository_root, ".agents", "skills")
    @manifest_path = File.join(@repository_root, ".agents", "external-skills.json")
    @changed_files = []
  end

  def run(args)
    if args == ["--check"]
      checker = AgentGuidance.new(@repository_root)
      valid = checker.check
      checker.report(output: $stdout, diagnostics: $stderr)
      return valid
    end
    load_manifest.each { |name, entry| AgentSkill.new(name, entry) }
    if (index = args.index("--add"))
      url = args[index + 1]
      name = args[index + 2] unless args[index + 2]&.start_with?("-")
      abort "Usage: sync-agents --add <github-url> [skill-name]" unless url
      repo = parse_github_repo(url)
      abort "Could not parse GitHub repo from: #{url}" unless repo
      AgentSkill.new(name, { "repo" => repo, "path" => name, "ref" => "HEAD" }) if name
    end
    AgentCompatibility.new(@repository_root).sync do
      if repo
        add_skill(repo, name)
      elsif args.include?("--install")
        install_skills
      elsif args.include?("--update")
        update_skills
      end

      update_skills_gitignore
    end

    stage_files if args.include?("--git-add") && !@changed_files.empty?
  end

  private

  # --- Gitignore management for external skills ---

  def update_skills_gitignore
    manifest = load_manifest
    gitignore_path = File.join(@skills_directory, ".gitignore")

    if manifest.empty?
      remove_if_exists(gitignore_path) if File.exist?(gitignore_path)
      return
    end

    lines = manifest.keys.sort.map { |name| "/#{name}/\n" }
    content = "# External skills — fetched via ./sync-agents --install\n" + lines.join
    write_if_changed(gitignore_path, content)
  end

  # --- Add a new external skill ---

  def add_skill(repo, name)
    Dir.mktmpdir do |tmpdir|
      clone_default_branch(repo, tmpdir)

      if name
        skill_src = File.join(tmpdir, name)
        unless Dir.exist?(skill_src) && File.exist?(File.join(skill_src, "SKILL.md"))
          available = list_skills(tmpdir)
          abort "Skill '#{name}' not found in #{repo}. Available: #{available.join(", ")}"
        end
      else
        available = list_skills(tmpdir)
        case available.length
        when 0 then abort "No skills found in #{repo}"
        when 1 then name = available.first
        else abort "Multiple skills in #{repo}: #{available.join(", ")}\n" \
                    "Specify one: ./sync-agents --add https://github.com/#{repo} <name>"
        end
      end

      sha = head_sha(tmpdir)
      manifest = load_manifest
      manifest[name] = { "repo" => repo, "path" => name, "ref" => sha }
      skill = AgentSkill.new(name, manifest.fetch(name))
      install_skill(skill, tmpdir, manifest: manifest)
      puts "Added #{name} from #{repo}@#{sha[0..7]}"
    end
  end

  # --- Install external skills from manifest, repairing invalid layouts ---

  def install_skills
    manifest = load_manifest
    if manifest.empty?
      puts "No external skills in manifest."
      return
    end

    skills = manifest.map { |name, entry| AgentSkill.new(name, entry) }
    skills.each do |skill|
      name = skill.name
      dest = File.join(@skills_directory, name)
      next if skill.installed?(dest)

      Dir.mktmpdir do |tmpdir|
        clone_repo(skill.repository, skill.revision, tmpdir)
        install_skill(skill, tmpdir)
        puts "Installed #{name} from #{skill.repository}@#{skill.revision}"
      end
    end
  end

  # --- Update all external skills (force re-fetch) ---

  def update_skills
    manifest = load_manifest
    if manifest.empty?
      puts "No external skills to update."
      return
    end

    skills = manifest.map { |name, entry| AgentSkill.new(name, entry) }
    skills.each do |skill|
      name = skill.name
      Dir.mktmpdir do |tmpdir|
        clone_default_branch(skill.repository, tmpdir)
        sha = head_sha(tmpdir)

        if sha == skill.revision && skill.installed?(File.join(@skills_directory, name))
          puts "#{name} already at #{sha[0..7]}"
          next
        end

        updated = manifest.merge(name => manifest.fetch(name).merge("ref" => sha))
        install_skill(AgentSkill.new(name, updated.fetch(name)), tmpdir, manifest: updated)
        manifest = updated
        puts "Updated #{name} from #{skill.repository}@#{sha[0..7]}"
      end
    end
  end

  def install_skill(skill, checkout, manifest: nil)
    update = if manifest
      AgentSkillInstaller::ManifestUpdate.new(path: @manifest_path, content: JSON.pretty_generate(manifest) + "\n")
    end
    AgentSkillInstaller.new.install(
      skill, checkout: checkout, destination: File.join(@skills_directory, skill.name), manifest_update: update,
    )
    @changed_files << @manifest_path if update
  end

  # --- Helpers ---

  def write_if_changed(path, content)
    return if File.exist?(path) && File.read(path, encoding: "UTF-8") == content
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, content)
    puts "Updated #{path}"
    @changed_files << path
  end

  def remove_if_exists(path)
    return unless File.exist?(path)
    File.delete(path)
    puts "Removed #{path}"
    @changed_files << path
  end

  def stage_files
    @changed_files.each do |file|
      system("git", "add", "-A", "--", file, err: File::NULL)
    end
  end

  def parse_github_repo(url)
    match = url.match(%r{github\.com[/:]([^/]+/[^/]+?)(?:\.git)?/?$})
    match && match[1]
  end

  def clone_default_branch(repo, dest)
    url = "https://github.com/#{repo}.git"
    system("git", "init", "-q", dest, out: File::NULL, err: File::NULL)
    system("git", "-C", dest, "remote", "add", "origin", url, out: File::NULL, err: File::NULL)
    _, stderr, status = Open3.capture3("git", "-C", dest, "fetch", "--depth", "1", "origin", "HEAD")
    abort "Failed to clone #{repo}: #{stderr}" unless status.success?
    checkout_ok = system("git", "-C", dest, "checkout", "-q", "FETCH_HEAD", out: File::NULL, err: File::NULL)
    abort "Failed to check out #{repo}@FETCH_HEAD" unless checkout_ok
  end

  def clone_repo(repo, ref, dest)
    url = "https://github.com/#{repo}.git"
    system("git", "init", "-q", dest, out: File::NULL, err: File::NULL)
    system("git", "-C", dest, "remote", "add", "origin", url, out: File::NULL, err: File::NULL)
    _, stderr, status = Open3.capture3("git", "-C", dest, "fetch", "--depth", "1", "origin", ref)
    abort "Failed to fetch #{repo}@#{ref}: #{stderr}" unless status.success?
    checkout_ok = system("git", "-C", dest, "checkout", "-q", "FETCH_HEAD", out: File::NULL, err: File::NULL)
    abort "Failed to check out #{repo}@#{ref}" unless checkout_ok
  end

  def head_sha(repo_dir)
    stdout, _, status = Open3.capture3("git", "-C", repo_dir, "rev-parse", "HEAD")
    abort "Failed to resolve HEAD in #{repo_dir}" unless status.success?
    stdout.strip
  end

  def list_skills(dir)
    Dir.children(dir)
      .select { |name| File.exist?(File.join(dir, name, "SKILL.md")) }
      .sort
  end

  def load_manifest
    return {} unless File.exist?(@manifest_path)
    result = JSON.parse(File.read(@manifest_path))
    raise AgentSkill::Error, "external-skills.json must contain an object" unless result.is_a?(Hash)
    result
  end
end

def usage(output = $stdout)
  output << <<~USAGE
    Usage: ./sync-agents [--install | --update | --add URL [NAME]] [--git-add]
           ./sync-agents --check

    Remove legacy instruction copies and link Claude skills to .agents/skills/.

    Options:
      --check         Check guidance offline without writing, fetching, or staging.
      --install       Fetch missing or invalid external skills at pinned revisions.
      --update        Refresh external skills and their pinned revisions.
      --add URL NAME  Add one external skill; NAME is optional for one-skill repos.
      --git-add       Stage manifest and external-skill ignore changes.
      -h, --help      Show this help without changing files or using the network.
  USAGE
end

def validate_arguments(arguments)
  if arguments.include?("--check")
    abort "error: --check cannot be combined with other options" unless arguments == ["--check"]
    return
  end
  action_count = arguments.count { |argument| %w[--install --update --add].include?(argument) }
  abort "error: choose only one of --install, --update, or --add" if action_count > 1

  remaining = arguments.dup
  if (index = remaining.index("--add"))
    url = remaining[index + 1]
    abort "error: --add requires a GitHub URL" if url.nil? || url.start_with?("-")
    remaining.delete_at(index)
    remaining.delete_at(index)
    remaining.delete_at(index) if remaining[index] && !remaining[index].start_with?("-")
  end
  remaining.delete("--install")
  remaining.delete("--update")
  remaining.delete("--git-add")
  abort "error: unknown option '#{remaining.first}'" unless remaining.empty?
end

if __FILE__ == $PROGRAM_NAME
  if ARGV == ["--help"] || ARGV == ["-h"]
    usage
    exit 0
  end
  validate_arguments(ARGV)
  begin
    result = SyncAgents.new.run(ARGV)
    exit 1 if ARGV == ["--check"] && !result
  rescue AgentSkill::Error, FileTransaction::Error, JSON::ParserError, SystemCallError, IOError => error
    abort "error: #{error.message}"
  end
end
