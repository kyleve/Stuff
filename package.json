{
  "name": "stuff-web-tooling",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "Tools/InstallerKit/Site",
    "Shared/Flyover/Web"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint:python && npm run lint:web && npm run lint:css && npm run format:python:check",
    "format:python": "mise exec -- ruff format .",
    "format:python:check": "mise exec -- ruff format --check .",
    "lint:python": "mise exec -- ruff check .",
    "lint:web": "eslint Shared/Flyover/Web Tools/InstallerKit/Site Tools/Tests/*.test.mjs *.config.mjs --max-warnings 0",
    "test:lint": "node --test Tools/Tests/lint_rules.test.mjs",
    "lint:css": "stylelint 'Shared/Flyover/Web/src/**/*.css' 'Tools/InstallerKit/Site/src/**/*.css' --max-warnings 0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "astro": "7.4.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
