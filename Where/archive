#!/bin/bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ./Where/archive --profiles DIR --output DIR

Archive optimized Where Development and export an ad hoc IPA.
Requires an installed Apple Distribution signing identity and installed profiles.

Options:
  --profiles DIR  Contains Where.mobileprovision, WhereWidgets.mobileprovision,
                  and WhereShareExtension.mobileprovision
  --output DIR    New directory for the archive, IPA, and build logs
  -h, --help      Show help without requiring Xcode or signing credentials

Setup and CI publication: Where/DISTRIBUTION.md
EOF
}

PROFILES=""
OUTPUT=""
while [ $# -gt 0 ]; do
    case "$1" in
        --profiles|--output)
            option="$1"
            shift
            if [ -z "${1:-}" ] || [[ "$1" == --* ]]; then
                echo "error: $option requires a directory" >&2
                exit 1
            fi
            case "$option" in
                --profiles) PROFILES="$1" ;;
                --output) OUTPUT="$1" ;;
            esac
            ;;
        -h|--help) usage; exit 0 ;;
        *) echo "error: unknown option '$1'" >&2; exit 1 ;;
    esac
    shift
done

if [ -z "$PROFILES" ] || [ -z "$OUTPUT" ]; then
    echo "error: --profiles and --output are required (see ./Where/archive --help)" >&2
    exit 1
fi
if [ -e "$OUTPUT" ] || [ -L "$OUTPUT" ]; then
    echo "error: output directory already exists: $OUTPUT" >&2
    exit 1
fi
for target in Where WhereWidgets WhereShareExtension; do
    if [ ! -f "$PROFILES/$target.mobileprovision" ]; then
        echo "error: missing $PROFILES/$target.mobileprovision" >&2
        exit 1
    fi
done

PROFILES="$(cd "$PROFILES" && pwd)"
OUTPUT="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$OUTPUT")"
cd "$(dirname "$0")/.."
SIGNING="$(mktemp -d "${TMPDIR:-/tmp}/where-archive.XXXXXX")"
trap 'rm -rf "$SIGNING"' EXIT
for target in Where WhereWidgets WhereShareExtension; do
    security cms -D -i "$PROFILES/$target.mobileprovision" >"$SIGNING/$target.plist"
done
python3 Tools/where_signing.py prepare --profiles "$SIGNING" --output "$SIGNING/plan"
# Only validated UUIDs and the team identifier are emitted by the helper.
# shellcheck source=/dev/null
source "$SIGNING/plan/signing.env"

./ide --no-open
mise exec -- xcodebuild -showBuildSettings -json \
    -project Stuff.xcodeproj -target Where -target WhereWidgets -target WhereShareExtension \
    -configuration Debug -sdk iphoneos >"$SIGNING/settings.json"
python3 Tools/where_signing.py validate-settings \
    --settings "$SIGNING/settings.json" --profiles "$SIGNING/plan/profiles.json"

# Keep the project's Local defaults unless the distribution controller supplies metadata.
installer_settings=("INSTALLER_APP_ID=where")
for installer_setting in INSTALLER_REPOSITORY_URL INSTALLER_CHANNEL INSTALLER_RUN INSTALLER_ATTEMPT INSTALLER_FEED_URL; do
    if [ -n "${!installer_setting:-}" ]; then
        installer_settings+=("$installer_setting=${!installer_setting}")
    fi
done

mkdir -p "$OUTPUT"
mise exec -- xcodebuild archive \
    -workspace Stuff.xcworkspace -scheme 'Where Development' \
    -configuration Debug -destination 'generic/platform=iOS' \
    -archivePath "$OUTPUT/Where.xcarchive" -derivedDataPath "$OUTPUT/DerivedData" \
    SWIFT_OPTIMIZATION_LEVEL=-O GCC_OPTIMIZATION_LEVEL=s \
    "${installer_settings[@]}" \
    2>&1 | tee "$OUTPUT/archive.log"
mise exec -- xcodebuild -exportArchive \
    -archivePath "$OUTPUT/Where.xcarchive" -exportPath "$OUTPUT/export" \
    -exportOptionsPlist "$SIGNING/plan/ExportOptions.plist" \
    2>&1 | tee "$OUTPUT/export.log"
if [ ! -f "$OUTPUT/export/Where.ipa" ]; then
    echo "error: Xcode did not export Where.ipa" >&2
    exit 1
fi
echo "Exported $OUTPUT/export/Where.ipa"
