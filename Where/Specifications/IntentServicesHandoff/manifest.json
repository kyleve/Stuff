{
  "source": "pluscal",
  "module": "IntentServicesHandoff.tla",
  "cases": [
    {
      "name": "current",
      "config": "Current.cfg",
      "expect": "pass"
    },
    {
      "name": "self-create",
      "config": "SelfCreate.cfg",
      "expect": "fail",
      "outputContains": "Invariant NoSelfCreate is violated."
    },
    {
      "name": "clear-unblocks",
      "config": "ClearUnblocks.cfg",
      "expect": "fail",
      "outputContains": "Invariant ClearPreservesBlock is violated."
    },
    {
      "name": "double-resume",
      "config": "DoubleResume.cfg",
      "expect": "fail",
      "outputContains": "Invariant WaiterAtMostOnce is violated."
    },
    {
      "name": "old-read-after-recovery",
      "config": "OldReadAfterRecovery.cfg",
      "expect": "fail",
      "outputContains": "Invariant OldReadAfterRecoveryNotReached is violated."
    },
    {
      "name": "two-waiters",
      "config": "TwoWaiters.cfg",
      "expect": "fail",
      "outputContains": "Invariant TwoWaitersNotReached is violated."
    }
  ]
}
