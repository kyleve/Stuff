{
  "source": "pluscal",
  "module": "CompatibilityVerification.tla",
  "cases": [
    {
      "name": "current",
      "config": "Current.cfg",
      "expect": "pass"
    },
    {
      "name": "skip-remote-read",
      "config": "SkipRemoteRead.cfg",
      "expect": "fail",
      "outputContains": "Invariant RemoteMeansRemote is violated."
    },
    {
      "name": "stale-completion",
      "config": "StaleCompletion.cfg",
      "expect": "fail",
      "outputContains": "Invariant HigherFloorWins is violated."
    },
    {
      "name": "local-unblocks",
      "config": "LocalUnblocks.cfg",
      "expect": "fail",
      "outputContains": "Invariant OnlyVerificationUnblocks is violated."
    },
    {
      "name": "local-during-remote",
      "config": "LocalDuringRemote.cfg",
      "expect": "fail",
      "outputContains": "Invariant LocalDuringRemoteNotReached is violated."
    }
  ]
}
