{
  "source": "pluscal",
  "module": "CompatibilityVerification.tla",
  "cases": [
    {
      "name": "shared-new",
      "config": "shared-new.cfg",
      "expect": "pass"
    },
    {
      "name": "shared-legacy",
      "config": "shared-legacy.cfg",
      "expect": "pass"
    },
    {
      "name": "local-new",
      "config": "local-new.cfg",
      "expect": "pass"
    },
    {
      "name": "local-legacy",
      "config": "local-legacy.cfg",
      "expect": "pass"
    },
    {
      "name": "overwrite-init",
      "config": "overwrite-init.cfg",
