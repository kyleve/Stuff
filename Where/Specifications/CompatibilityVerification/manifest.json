    },
    {
      "name": "stale-grant",
      "config": "stale-grant.cfg",
      "expect": "fail",
      "outputContains": "Invariant NoStaleGrant is violated."
    },
    {
      "name": "forget-high",
      "config": "forget-high.cfg",
      "expect": "fail",
      "outputContains": "Invariant KnowledgeIsDurable is violated."
    },
    {
      "name": "payload-first",
      "config": "payload-first.cfg",
      "expect": "fail",
      "outputContains": "Invariant AdmitBeforePayload is violated."
    },
    {
      "name": "record-first",
      "config": "record-first.cfg",
      "expect": "fail",
      "outputContains": "Invariant RecordFirstNotReached is violated."
    },
    {
      "name": "stale-completion",
      "config": "stale-completion.cfg",
      "expect": "fail",
      "outputContains": "Invariant StaleCompletionNotReached is violated."
    },
    {
      "name": "failed-floor-write",
      "config": "failed-floor-write.cfg",
      "expect": "pass"
    },
    {
      "name": "missing-read-fence",
      "config": "missing-read-fence.cfg",
      "expect": "fail",
      "outputContains": "Invariant KnowledgeIsDurable is violated."
    }
  ]
