{
  "sourceLanguage" : "en",
  "strings" : {
    "backup.error.committedCleanup.merge" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup was imported, but Where could not finish recording cleanup. Recording remains off. Close and reopen Where to finish safely; do not import the backup again."
          }
        }
      }
    },
    "backup.error.committedCleanup.replace" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup was restored, but Where could not remove pending location fixes. Recording remains off. Close and reopen Where to finish safely; do not restore the backup again."
          }
        }
      }
    },
    "backup.error.invalidPlanningData" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup contains invalid planned stays. Check its dates and try again."
          }
        }
      }
    },
    "backup.error.invalidRecordingData" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup contains invalid recording-device data and can't be imported."
          }
        }
      }
    },
    "backup.error.manifestMissing" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file isn't a Where backup (no manifest was found)."
          }
        }
      }
    },
    "backup.error.missingDeviceModel" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device model information is missing. Allow the devices to finish syncing before exporting again, or upgrade the original backup."
          }
        }
      }
    },
    "backup.error.recoveryRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where must finish cleanup from the previous backup before another backup can be imported."
          }
        }
      }
    },
    "backup.error.unsupportedFormatVersion" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup was created by an incompatible version of Where (format %lld) and can't be imported."
          }
        }
      }
    },
    "compatibility.error.permission" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Always location access on your recording device, then open Where."
          }
        }
      }
    },
    "compatibility.error.recording" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the latest Where on your recording device before using this version."
          }
        }
      }
    },
    "compatibility.error.update" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Where to open data used by a newer version."
          }
        }
      }
    },
    "compatibility.error.verify" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Where and connect to iCloud to verify data compatibility."
          }
        }
      }
    },
    "compatibility.version1.reason" : {
      "comment" : "Describes the first version of Where’s shared data format, including data saved before app versions were checked.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where now checks that each device can open your shared data before it syncs."
          }
        }
      }
    },
    "compatibility.version2.reason" : {
      "comment" : "Explains why earlier versions of Where cannot open shared history that uses Canadian province and territory IDs.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where can now save visits to Canadian provinces and territories."
          }
        }
      }
    },
    "compatibility.version3.reason" : {
      "comment" : "Explains the shared data update that identifies recording and correcting devices.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where now saves which device recorded a location and which device corrected it."
          }
        }
      }
    },
    "compatibility.version4.reason" : {
      "comment" : "Explains the shared data update that lets other installations display a device model.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where can now show the model of each device in your history."
          }
        }
      }
    },
