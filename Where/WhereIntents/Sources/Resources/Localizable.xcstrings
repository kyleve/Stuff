{
  "sourceLanguage" : "en",
  "strings" : {
    "audit.note.siri" : {
      "comment" : "Note stored on a manual day entry made through an intent.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logged with Siri"
          }
        }
      }
    },
    "dialog.daysInRegion.none" : {
      "comment" : "Spoken result when a region has no logged days this year. %1$@ region name, %2$@ year.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have no days logged in %1$@ so far in %2$@."
          }
        }
      }
    },
    "dialog.daysInRegion.one" : {
      "comment" : "Spoken result for exactly one day in a region. %1$@ region name, %2$@ year.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have 1 day in %1$@ so far in %2$@."
          }
        }
      }
    },
    "dialog.daysInRegion.other" : {
      "comment" : "Spoken result for a day count in a region. %1$lld count, %2$@ region name, %3$@ year.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have %1$lld days in %2$@ so far in %3$@."
          }
        }
      }
    },
    "dialog.logged.chooseRegions" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell me which regions to log."
          }
        }
      }
    },
    "dialog.logged.day" : {
      "comment" : "Confirmation after logging a day. %1$@ region list, %2$@ date.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logged %1$@ for %2$@."
          }
        }
      }
    },
    "dialog.logged.emptyRange" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That date range doesn't include any days."
          }
        }
      }
    },
    "dialog.logged.trip.one" : {
      "comment" : "Confirmation after backfilling exactly one day. %1$@ region list.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logged %1$@ for 1 day."
          }
        }
      }
    },
    "dialog.logged.trip.other" : {
      "comment" : "Confirmation after backfilling a trip. %1$@ region list, %2$lld day count.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logged %1$@ for %2$lld days."
          }
        }
      }
    },
    "dialog.regionOnDate.none" : {
      "comment" : "Spoken result when a date has nothing logged. %1$@ formatted date.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is logged for %1$@."
          }
        }
      }
    },
    "dialog.regionOnDate.some" : {
      "comment" : "Spoken result naming the regions a date counted for. %1$@ date, %2$@ region list.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On %1$@ you were in %2$@."
          }
        }
      }
    },
    "dialog.recentActivity.empty" : {
      "comment" : "Spoken result when a window has no tracked activity. %1$@ window phrase.",
