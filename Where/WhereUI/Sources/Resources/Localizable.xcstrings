      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your backup data was imported successfully, but Where couldn't finish setting up this device. Close and reopen Where; setup will retry automatically. Do not import this backup again.\n\n%@"
          }
        }
      }
    },
